# Copy this file to ".env" and fill in your own values.  (.env is never committed)
PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/ministore
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ministore?retryWrites=true&w=majority

# Allowed browser origins for CORS (comma separated). The frontend served by this server needs no CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
